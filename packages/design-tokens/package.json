{
  "name": "@repo/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/tokens.ts",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "generate": "node --experimental-strip-types src/generate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"**/*.{ts,js}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,js}\" --cache"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.14.10",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
