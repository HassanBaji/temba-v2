{
  "name": "temba-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web --filter=api",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "start:web": "turbo run start --filter=web",
    "start:api": "turbo run start --filter=api",
    "dev:console": "turbo run dev --filter=console --filter=api",
    "build:console": "turbo run build --filter=console",
    "start:console": "turbo run start --filter=console"
  },
  "dependencies": {
    "turbo": "^2.10.11"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.41.0"
    }
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
