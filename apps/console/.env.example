# Copy to ".env" and fill in. Variables are validated in src/env.js.

# Clerk (https://dashboard.clerk.com). Same instance as the web App; staff sign
# in with the Temba account they play with.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"

# Origin of the API App (apps/api). The /api rewrite and the server-side client call it.
# The API must list this App's origin in AUTHORIZED_PARTIES (or CONSOLE_ORIGIN).
# A bare host also works: on Railway use the private reference
# "${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}" (plain HTTP on the internal network).
API_ORIGIN="http://localhost:4000"

# Optional. Public origin of the web App, for "Back to Temba" links.
NEXT_PUBLIC_WEB_ORIGIN="http://localhost:3000"
