{
  "expo": {
    "name": "Temba",
    "slug": "temba",
    "scheme": "temba",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.temba.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["en", "ar"]
      }
    },
    "android": {
      "package": "app.temba.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Temba uses your photo library so you can choose a profile photo and add photos to a game's album.",
          "cameraPermission": "Temba uses your camera so you can take a profile photo or a photo for a game's album."
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Archivo-Regular.ttf",
            "./assets/fonts/Archivo-Medium.ttf",
            "./assets/fonts/Archivo-SemiBold.ttf",
            "./assets/fonts/Archivo-Bold.ttf",
            "./assets/fonts/ArchivoExpanded-Bold.ttf",
            "./assets/fonts/GeistMono-Regular.ttf"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Temba saves result cards, stickers and game album photos to your photo library."
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json"
    }
  }
}
