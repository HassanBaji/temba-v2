{
  "expo": {
    "name": "Temba",
    "slug": "temba",
    "scheme": "temba",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.temba.mobile",
      "usesAppleSignIn": true,
      "supportsTablet": false
    },
    "android": {
      "package": "app.temba.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "@clerk/expo",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Archivo-Regular.ttf",
            "./assets/fonts/Archivo-Medium.ttf",
            "./assets/fonts/Archivo-SemiBold.ttf",
            "./assets/fonts/Archivo-Bold.ttf",
            "./assets/fonts/ArchivoExpanded-Bold.ttf",
            "./assets/fonts/GeistMono-Regular.ttf"
          ]
        }
      ]
    ]
  }
}
