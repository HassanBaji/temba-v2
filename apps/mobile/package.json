{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8081",
    "ios": "expo start --ios --port 8081",
    "android": "expo start --android --port 8081",
    "export:check": "expo export --platform ios --platform android --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\" --cache"
  },
  "dependencies": {
    "@clerk/expo": "^4.8.0",
    "@repo/design-tokens": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/validators": "workspace:*",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "lightningcss": "1.30.1",
    "lucide-react-native": "^1.52.0",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.10.1",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@repo/api": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.19.25",
    "@types/react": "~19.2.0",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
