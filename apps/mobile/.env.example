# Clerk development instance publishable key (the same value as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in apps/web).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Optional. Leave empty in development: the App derives the API host from the Expo dev server host
# (a phone on the same network reaches the API on port 4000). Set it for a staging or production API.
# EAS builds take it from eas.json: the preview and production origins there are placeholders
# (staging-api.temba.app, api.temba.app) until the Railway API domains are known. A preview or
# production build without an https origin fails in app.config.ts instead of crashing on launch.
EXPO_PUBLIC_API_ORIGIN=""

# Optional. Public https origin of the web App (WEB_ORIGIN there). A build that sets it claims the
# host for universal links, so a shared Game page link opens the Game in the App. The web App must
# set APPLE_APP_ID to serve the matching association file.
EXPO_PUBLIC_WEB_ORIGIN=""
