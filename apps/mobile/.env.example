# Clerk development instance publishable key (the same value as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in apps/web).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Optional. Leave empty in development: the App derives the API host from the Expo dev server host
# (a phone on the same network reaches the API on port 4000). Set it for a staging or production API.
EXPO_PUBLIC_API_ORIGIN=""
