# Copy to ".env" and fill in. Variables are validated in src/env.ts.

PORT=4000

# Clerk (https://dashboard.clerk.com). Same instance as the web App.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# Optional. PEM public key of the Clerk instance (Dashboard, API keys, Show JWT
# public key). When set, session tokens are verified without a network call.
CLERK_JWT_KEY=""

# Public origin of the web App. Invite links are built from it.
WEB_ORIGIN="http://localhost:3000"

# Optional, comma separated. Extra web origins allowed as the token's azp claim.
# WEB_ORIGIN is always allowed. Tokens without azp (Expo) pass.
AUTHORIZED_PARTIES=""

# Optional. Public origin of the Venue console App (apps/console), allowed as azp like WEB_ORIGIN.
CONSOLE_ORIGIN="http://localhost:3001"

# Rollback flag for the bearer-only session check. "true" also accepts the Clerk
# __session cookie. Leave "false".
ACCEPT_SESSION_COOKIE="false"

DATABASE_URL="postgresql://postgres:password@localhost:5432/temba"

# Railway Bucket (Venue logos and Group images)
AWS_ENDPOINT_URL="https://t3.storageapi.dev"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="customizable-pannier-xnbsgm"
AWS_DEFAULT_REGION="auto"

# Job queue (Graphile Worker, runs in this process). Set API_ENABLED="false" and
# WORKER_ENABLED="true" to run the same image as a worker-only service.
WORKER_ENABLED="true"
API_ENABLED="true"
WORKER_CONCURRENCY="5"

# Payments. "manual" (default) collects nothing and lets a manager settle by hand.
# "tap" needs the test keys from the Tap dashboard and the public URL of this API,
# which Tap calls back at API_PUBLIC_URL/webhooks/payments/tap.
PAYMENT_PROVIDER="manual"
TAP_SECRET_KEY=""
TAP_PUBLIC_KEY=""
# The online methods switched on for the Tap merchant account, in checkout order:
# card, benefit (BENEFIT debit card), benefitpay (BenefitPay app or QR) and
# apple_pay (needs the domain verified with Tap). Unset offers card, benefit and
# benefitpay.
TAP_PAYMENT_METHODS="card,benefit,benefitpay"
API_PUBLIC_URL=""
# Deep link base the return page opens, followed by /{bookingId}?returned=1.
PAYMENT_RETURN_URL="temba://book/bookings"
