# Copy to ".env" and fill in. Variables are validated in src/env.ts.

PORT=4000

# Clerk (https://dashboard.clerk.com). Same instance as the web App.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# Public origin of the web App. Invite links are built from it.
WEB_ORIGIN="http://localhost:3000"

DATABASE_URL="postgresql://postgres:password@localhost:5432/temba"

# Railway Bucket (Venue logos and Group images)
AWS_ENDPOINT_URL="https://t3.storageapi.dev"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="customizable-pannier-xnbsgm"
AWS_DEFAULT_REGION="auto"
