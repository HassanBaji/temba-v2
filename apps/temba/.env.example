# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
# Point Clerk buttons / protect() at the custom screens (also set on ClerkProvider).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/temba"

# Railway Bucket (Venue logos). Empty keys fail validation; Cloud install writes
# placeholders when unset so /login still boots. Live upload and media GET need
# real AWS SDK credentials.
AWS_ENDPOINT_URL="https://t3.storageapi.dev"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="customizable-pannier-xnbsgm"
AWS_DEFAULT_REGION="auto"

# Supabase Storage (Group images until TEM-238)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_GROUP_IMAGES_BUCKET="group-images"
